    {"id": "dev-count-total", "question": "How many reports are in the corpus?", "count": 20000, "denominator": 20000, "filters": {"year_start": null, "year_end": null, "anomaly_category": null}, "source": "eval/corpus_manifest_20k.json"}
  ],
